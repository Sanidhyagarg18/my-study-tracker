<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Study Tracker</title>

<style>
body {
  font-family: Arial, sans-serif;
  background: #f0f4fa;
  margin: 0;
  padding: 30px 15px;
  color: #202b40;
}

.container {
  max-width: 550px;
  margin: auto;
  background: white;
  padding: 25px;
  border-radius: 16px;
  box-shadow: 0 5px 20px #00000012;
}

h1 { color: #315be8; }

.subtitle { color: #718096; }

.input-area {
  display: flex;
  gap: 8px;
}

input {
  flex: 1;
  min-width: 0;
  padding: 12px;
  border: 1px solid #ccd5e2;
  border-radius: 8px;
}

button {
  padding: 11px 15px;
  background: #315be8;
  color: white;
  border: none;
  border-radius: 8px;
  cursor: pointer;
}

li {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 0;
  border-bottom: 1px solid #eee;
}

li span { flex: 1; }

.done {
  text-decoration: line-through;
  color: #999;
}

.delete {
  background: #e34d4d;
}

.progress {
  background: #e5eaf2;
  height: 10px;
  border-radius: 10px;
  overflow: hidden;
  margin-top: 12px;
}

#bar {
  height: 100%;
  width: 0%;
  background: #315be8;
  transition: width .3s;
}
</style>
</head>

<body>
<div class="container">

<h1>📚 My Study Tracker</h1>
<p class="subtitle">Plan your day. Complete your goals.</p>

<div class="input-area">
<input id="taskInput" placeholder="Enter a study task...">
<button onclick="addTask()">Add</button>
</div>

<h3>Today's Tasks</h3>
<ul id="taskList"></ul>

<h3 id="progressText">Progress: 0%</h3>
<div class="progress">
<div id="bar"></div>
</div>

</div>

<script>
let tasks = JSON.parse(
  localStorage.getItem("studyTasks") || "[]"
);

function save() {
  localStorage.setItem("studyTasks", JSON.stringify(tasks));
  render();
}

function addTask() {
  const input = document.getElementById("taskInput");
  const text = input.value.trim();

  if (!text) return;

  tasks.push({ text: text, done: false });
  input.value = "";
  save();
}

function toggleTask(index) {
  tasks[index].done = !tasks[index].done;
  save();
}

function deleteTask(index) {
  tasks.splice(index, 1);
  save();
}

function render() {
  const list = document.getElementById("taskList");
  list.innerHTML = "";

  tasks.forEach((task, index) => {
    const li = document.createElement("li");

    const checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.checked = task.done;
    checkbox.addEventListener("change", () => toggleTask(index));

    const span = document.createElement("span");
    span.textContent = task.text;
    if (task.done) span.classList.add("done");

    const del = document.createElement("button");
    del.textContent = "Delete";
    del.className = "delete";
    del.onclick = () => deleteTask(index);

    li.append(checkbox, span, del);
    list.appendChild(li);
  });

  const completed = tasks.filter(t => t.done).length;
  const percent = tasks.length
    ? Math.round(completed / tasks.length * 100)
    : 0;

  document.getElementById("progressText").textContent =
    `Progress: ${percent}%`;

  document.getElementById("bar").style.width = percent + "%";
}

render();
</script>

</body>
</html>
